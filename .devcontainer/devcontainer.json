{
    "name": "TyC Compiler",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {},
        "ghcr.io/devcontainers/features/java:1": {
            "version": "21"
        }
    },
    "postCreateCommand": "python -m venv venv && . venv/bin/activate && pip install -U pip && pip install -r requirements.txt",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy"
            ]
        }
    }
}